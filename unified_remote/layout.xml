<?xml version="1.0" encoding="utf-8"?>
<layout>
  <tabs>
    <tab text="Main">
      <row weight="2">
        <button icon="config" ontap="nav_settings" darkcolor="#262626"/>
        <button icon="up" ontap="nav_up" darkcolor="#8a5cf5"/>
        <button icon="power" ontap="toggle_screen" darkcolor="#262626"/>
      </row>
      <row weight="2">
        <button icon="left" ontap="nav_left" darkcolor="#8a5cf5"/>
        <button icon="select" ontap="nav_ok" darkcolor="#8a5cf5"/>
        <button icon="right" ontap="nav_right" darkcolor="#8a5cf5"/>
      </row>
      <row weight="2">
        <button icon="back" ontap="nav_back" darkcolor="#262626"/>
        <button icon="down" ontap="nav_down" darkcolor="#8a5cf5"/>
        <button icon="home" ontap="nav_home" darkcolor="#262626"/>
      </row>
      <row weight="1">
        <button icon="rwd" ontap="media_rewind" darkcolor="#262626"/>
        <button icon="play" ontap="media_play" darkcolor="#262626"/>
        <button icon="pause" ontap="media_pause" darkcolor="#262626"/>
        <button icon="ff" ontap="media_fast_forward" darkcolor="#262626"/>
      </row>
      <row weight="2">
        <button icon="vdown" ontap="vol_down" darkcolor="#262626"/>
        <button icon="vmute" ontap="toggle_mute" darkcolor="#262626"/>
        <button icon="vup" ontap="vol_up" darkcolor="#262626"/>
      </row>
    </tab>
    <tab text="Source">
      <row weight="1">
        <label text="Video" darkcolor="#262626"/>
      </row>
      <row weight="3">
          <button text="PC" ontap="input_hdmi3" darkcolor="#8a5cf5"/>
          <button text="Switch" ontap="input_hdmi2" darkcolor="#8a5cf5"/>
      </row>
      <row weight="1">
        <label text="Audio" darkcolor="#262626"/>
      </row>
      <row weight="3">
        <button text="TV" ontap="audio_tv" darkcolor="#8a5cf5"/>
        <button text="PC" ontap="audio_speakers" darkcolor="#8a5cf5"/>
      </row>
    </tab>
    <tab text="Numpad">
      <row>
        <button text="1" ontap="numpad_1" darkcolor="#262626"/>
        <button text="2" ontap="numpad_2" darkcolor="#262626"/>
        <button text="3" ontap="numpad_3" darkcolor="#262626"/>
      </row>
      <row>
        <button text="4" ontap="numpad_4" darkcolor="#262626"/>
        <button text="5" ontap="numpad_5" darkcolor="#262626"/>
        <button text="6" ontap="numpad_6" darkcolor="#262626"/>
      </row>
      <row>
        <button text="7" ontap="numpad_7" darkcolor="#262626"/>
        <button text="8" ontap="numpad_8" darkcolor="#262626"/>
        <button text="9" ontap="numpad_9" darkcolor="#262626"/>
      </row>
      <row>
        <button text="0" ontap="numpad_0" darkcolor="#8a5cf5"/>
      </row>
    </tab>
    <tab text="Apps">
      <row>
        <list>
          <item text="Spotify" ontap="launch_spotify"/>
          <item text="Netflix" ontap="launch_netflix"/>
          <item text="YouTube" ontap="launch_youtube"/>
        </list>
      </row>
    </tab>
  </tabs>
</layout>