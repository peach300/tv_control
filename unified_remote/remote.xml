<remote name="LG TV" id="com.custom.lgtv" cacheable="false">
  <layout>
    <row>
      <button title="Vol +" action="vol_up"/>
      <button title="Mute" action="mute"/>
      <button title="Vol -" action="vol_down"/>
    </row>
    <row>
      <button title="▲" action="nav_up"/>
    </row>
    <row>
      <button title="◄" action="nav_left"/>
      <button title="OK" action="nav_ok"/>
      <button title="►" action="nav_right"/>
    </row>
    <row>
      <button title="▼" action="nav_down"/>
    </row>
    <row>
      <button title="Back" action="nav_back"/>
      <button title="Home" action="nav_home"/>
    </row>
    <row>
      <button title="HDMI 1" action="input_hdmi1"/>
      <button title="HDMI 2" action="input_hdmi2"/>
    </row>
    <row>
      <button title="Standby" action="standby"/>
    </row>
  </layout>
</remote>